<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="#1FFFFFFF" />
                    <corners android:radius="29dp" />
                    <stroke android:width="1dp" android:color="@color/glass_line" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="@color/violet" android:endColor="@color/cyan" />
                    <corners android:radius="29dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
