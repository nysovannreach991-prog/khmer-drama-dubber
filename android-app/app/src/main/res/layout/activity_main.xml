<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.01"
                    android:text="Khmer Dubber"
                    android:textColor="@color/text"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Video + subtitle  →  Khmer voice"
                    android:textColor="@color/text2"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                style="@style/IconButton"
                android:contentDescription="Settings"
                android:src="@drawable/ic_tune" />
        </LinearLayout>

        <!-- update available -->
        <LinearLayout
            android:id="@+id/cardUpdate"
            style="@style/Glass"
            android:layout_marginTop="22dp"
            android:background="@drawable/glass_card_update"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtUpdateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtUpdateNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text2"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnUpdate"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_update"
                android:text="Update now"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- files -->
        <LinearLayout
            style="@style/Glass"
            android:layout_marginTop="22dp">

            <TextView
                style="@style/Eyebrow"
                android:text="FILES" />

            <Button
                android:id="@+id/btnVideo"
                style="@style/GlassPick"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="🎬   Choose video" />

            <Button
                android:id="@+id/btnSubtitle"
                style="@style/GlassPick"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="📝   Choose subtitle (.srt)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtPairs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="4dp"
                    android:text="Many episodes? Same names: ep01.mp4 + ep01.srt"
                    android:textColor="@color/text3"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:text="Clear"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- voice -->
        <LinearLayout
            style="@style/Glass"
            android:layout_marginTop="14dp">

            <TextView
                style="@style/Eyebrow"
                android:text="VOICE" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioGroup
                    android:id="@+id/rgVoice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/seg_bg"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <RadioButton
                        android:id="@+id/rbFemale"
                        style="@style/Segment"
                        android:text="Sreymom  ♀" />

                    <RadioButton
                        android:id="@+id/rbMale"
                        style="@style/Segment"
                        android:text="Piseth  ♂" />
                </RadioGroup>

                <ImageButton
                    android:id="@+id/btnPreview"
                    style="@style/IconButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="Listen to voice"
                    android:src="@drawable/ic_play" />
            </LinearLayout>
        </LinearLayout>

        <!-- logo & lower third -->
        <LinearLayout
            android:id="@+id/cardBrand"
            style="@style/Glass"
            android:layout_marginTop="14dp"
            android:background="@drawable/glass_card_tap"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Eyebrow"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="LOGO &amp; LOWER THIRD" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit  ›"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.khmerdubber.app.BrandPreviewView
                    android:id="@+id/brandThumb"
                    android:layout_width="112dp"
                    android:layout_height="63dp" />

                <TextView
                    android:id="@+id/txtBrand"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="4dp"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnStart"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_marginTop="22dp"
            android:text="Start dubbing" />

        <!-- progress -->
        <LinearLayout
            android:id="@+id/cardProgress"
            style="@style/Glass"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="14dp"
                android:max="1000"
                android:progressDrawable="@drawable/progress_glass" />

            <TextView
                android:id="@+id/txtDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/log_bg"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:padding="14dp"
                android:textColor="#D9FFFFFF"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnStop"
                    style="@style/GlassButton"
                    android:layout_width="wrap_content"
                    android:text="■  Stop" />

                <Button
                    android:id="@+id/btnPlay"
                    style="@style/GlassButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="▶  Play result" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Videos → Movies/KhmerDubber\nSubtitles → Download/KhmerDubber"
            android:textColor="@color/text3"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

    <!-- soft fade under the status bar so scrolled text doesn't run into the clock -->
    <View
        android:id="@+id/statusScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top" />
</FrameLayout>
